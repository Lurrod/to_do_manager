{
  "name": "to_do_manager",
  "version": "2.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "app": "node scripts/app.js",
    "backup": "node scripts/backup.js",
    "test": "npm run test:api && npm run test:ui",
    "test:api": "jest",
    "test:ui": "vitest run"
  },
  "keywords": [],
  "author": "Titouan Borde",
  "license": "ISC",
  "description": "Gestionnaire de tâches local — Express + MongoDB + frontend vanilla",
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drawably": "^0.3.10",
    "express": "^4.21.2",
    "mongodb-memory-server": "^11.1.0",
    "mongoose": "^8.9.7"
  },
  "devDependencies": {
    "happy-dom": "^20.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/test/api/**/*.test.js",
      "<rootDir>/test/server/**/*.test.js"
    ]
  }
